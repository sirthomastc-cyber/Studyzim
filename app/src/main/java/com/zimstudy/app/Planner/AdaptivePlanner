package com.zimstudy.app.planner

import com.zimstudy.app.data.PerformanceRepository
import com.zimstudy.app.data.StudyAnalytics
import com.zimstudy.app.data.StudySession


class AdaptivePlanner(
    private val repository: PerformanceRepository,
    private val studyAnalytics: StudyAnalytics = StudyAnalytics()
) {



    fun generatePlan(
        availableMinutes: Int,
        sessions: List<StudySession> = emptyList()
    ): StudyRecommendation {



        val records =
            repository.getAllRecords()



        if(records.isEmpty()) {


            return StudyRecommendation(

                subject = "General",

                topic = "Syllabus Setup",

                reason =
                "AI needs more learning data.",

                durationMinutes = availableMinutes

            )

        }



        val prioritySubject =
            records.maxByOrNull {


                calculatePriority(
                    it.quizAccuracy,
                    it.pastPaperAccuracy,
                    it.consistency,
                    studyAnalytics.calculateStudyFrequency(
                        sessions,
                        it.subjectName
                    )
                )

            }



        return StudyRecommendation(

            subject = prioritySubject!!.subjectName,

            topic = "Targeted Revision",

            reason =
            "AI selected this because your mastery and study activity show it needs attention.",

            durationMinutes = availableMinutes

        )


    }




    private fun calculatePriority(

        quizAccuracy: Double,

        pastPaperAccuracy: Double,

        consistency: Double,

        studyFrequency: Double

    ): Double {


        val mastery =
            (
            quizAccuracy +
            pastPaperAccuracy +
            consistency
            ) / 3



        val weakness =
            100 - mastery



        val lackOfPractice =
            100 - (studyFrequency * 10)
                .coerceIn(0.0,100.0)



        return (
                weakness * 0.7 +
                lackOfPractice * 0.3
                )

    }


}
