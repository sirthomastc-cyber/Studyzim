package com.zimstudy.app.planner

import com.zimstudy.app.data.PerformanceRepository


class AdaptivePlanner(
    private val repository: PerformanceRepository
) {


    fun generatePlan(
        availableMinutes: Int
    ): StudyRecommendation {


        val records =
            repository.getAllRecords()



        if(records.isEmpty()) {


            return StudyRecommendation(

                subject = "General",

                topic = "Syllabus Setup",

                reason =
                "AI needs study data first. Complete some sessions and quizzes.",

                durationMinutes = availableMinutes

            )

        }



        val priority =
            records.maxByOrNull {


                calculatePriority(
                    it.quizAccuracy,
                    it.pastPaperAccuracy,
                    it.consistency
                )

            }



        return StudyRecommendation(


            subject =
            priority!!.subjectName,


            topic =
            "High Priority Revision",


            reason =
            "AI detected this as your biggest improvement opportunity.",


            durationMinutes =
            availableMinutes


        )


    }




    private fun calculatePriority(

        quizAccuracy: Double,

        pastPaperAccuracy: Double,

        consistency: Double

    ): Double {



        val weakness =
            100 - (
                    (quizAccuracy +
                    pastPaperAccuracy +
                    consistency) / 3
                    )



        return weakness

    }


}
